# =============================================================================
# Society Site — environment configuration
# =============================================================================
# Copy this file to .env and edit before first launch.
#
#   cp .env.example .env
#
# Generate a secure SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# =============================================================================
# Secrets
# =============================================================================
# The first-run setup wizard refuses to start if this is unset or the default.
SECRET_KEY="CHANGE-ME-generate-with-secrets.token_urlsafe-48"

# =============================================================================
# Runtime mode
# =============================================================================
# production | development. Production enables HTTPS-only cookies, strict CSP,
# and disables the debugger.
FLASK_ENV="production"
FLASK_DEBUG=0

# =============================================================================
# Database
# =============================================================================
# Leave unset for SQLite (default — fine for small-to-moderate deployments).
# For Postgres:
#   DATABASE_URL="postgresql+psycopg://user:pass@host:5432/society"
# DATABASE_URL=""

# Connection pool tuning — relevant for Postgres under bursty load.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# =============================================================================
# Rate limiting / cache backend
# =============================================================================
# memory:// (default, single-process) or redis://host:6379 for multi-worker.
RATELIMIT_STORAGE_URI="memory://"

# =============================================================================
# Email
# =============================================================================
# MAIL_BACKEND: console | smtp
# console prints to stdout — fine for dev, DO NOT use in production.
MAIL_BACKEND="console"

# SMTP (only used when MAIL_BACKEND=smtp)
# Port 465 = implicit TLS, 587 = STARTTLS, 25 = plaintext (avoid).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_TIMEOUT=15

# Sender address for all outgoing mail (OTP codes, contact form, alerts).
MAIL_FROM="Your Society <noreply@example.com>"

# Admin contact — receives health-check alerts and contact-form submissions.
# Falls back to MAIL_FROM if unset.
# ADMIN_EMAIL="admin@example.com"

# =============================================================================
# Uploads
# =============================================================================
# Where uploaded images, logos, and abstract figures live. Use an absolute
# path in production so it survives code redeploys.
UPLOAD_FOLDER="./uploads"

# =============================================================================
# Server-side cookie hardening
# =============================================================================
# Set to 1 when serving over HTTPS (always true behind Cloudflare).
SESSION_COOKIE_SECURE=1

# =============================================================================
# Cloudflare Tunnel — zero-config deployment (launch.sh)
# =============================================================================
# Your domain name. Required if using launch.sh.
# CLOUDFLARE_DOMAIN="example.org"

# Optional subdomain (e.g. "www" for www.example.org). Leave blank for apex.
# CLOUDFLARE_SUBDOMAIN=""

# =============================================================================
# Gunicorn tuning (used by launch.sh and systemd units)
# =============================================================================
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=32
# PORT=5005

# =============================================================================
# Health-check monitor (scripts/healthcheck.py)
# =============================================================================
# Override the auto-detected site URL. Needed if the site is behind a proxy
# or you want to check a specific endpoint.
# SITE_URL="https://example.org"

# Consecutive failures before sending an alert email.
# HEALTHCHECK_RETRIES=3

# Seconds to wait between retries.
# HEALTHCHECK_RETRY_DELAY=30

# HTTP request timeout in seconds.
# HEALTHCHECK_TIMEOUT=15

# Minutes to suppress repeat alerts after the last one was sent.
# HEALTHCHECK_COOLDOWN=60

# =============================================================================
# Backup (scripts/backup.py)
# =============================================================================
# Number of days to keep daily backups before auto-pruning.
# BACKUP_KEEP_DAYS=30

# =============================================================================
# Update checker (future)
# =============================================================================
# Git remote checked by the admin-only update notifier. Leave blank to disable.
UPDATE_REMOTE_URL=""
UPDATE_BRANCH="main"
