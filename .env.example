# =============================================================================
# Society Site — environment configuration
# =============================================================================
# Copy this file to .env and edit before first launch.
#
#   cp .env.example .env
#
# Generate a secure SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# =============================================================================
# Secrets
# =============================================================================
# The first-run setup wizard refuses to start if this is unset or the default.
SECRET_KEY="CHANGE-ME-generate-with-secrets.token_urlsafe-48"

# =============================================================================
# Runtime mode
# =============================================================================
# production | development. Production enables HTTPS-only cookies, strict CSP,
# and disables the debugger.
FLASK_ENV="production"
FLASK_DEBUG=0

# =============================================================================
# Database
# =============================================================================
# Leave unset for SQLite (default — fine for small-to-moderate deployments).
# For Postgres:
#   DATABASE_URL="postgresql+psycopg://user:pass@host:5432/society"
# DATABASE_URL=""

# Postgres password (required only if using Postgres with docker-compose or
# systemd units that reference ${POSTGRES_PASSWORD}).
# POSTGRES_PASSWORD="CHANGE-ME"

# Connection pool tuning — relevant for Postgres under bursty load.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# =============================================================================
# Rate limiting / cache backend
# =============================================================================
# memory:// (default, single-process) or redis://host:6379 for multi-worker.
RATELIMIT_STORAGE_URI="memory://"

# =============================================================================
# Email
# =============================================================================
# MAIL_BACKEND: console | smtp
# console prints to stdout — fine for dev, DO NOT use in production.
MAIL_BACKEND="console"

# SMTP (only used when MAIL_BACKEND=smtp)
# Port 465 = implicit TLS, 587 = STARTTLS, 25 = plaintext (avoid).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_TIMEOUT=15

# Sender address for all outgoing mail (OTP codes, contact form, alerts).
MAIL_FROM="Your Society Name <noreply@your-domain.example.org>"

# Admin contact — receives health-check alerts and contact-form submissions.
# Falls back to MAIL_FROM if unset.
# ADMIN_EMAIL="admin@your-domain.example.org"

# =============================================================================
# Uploads
# =============================================================================
# Where uploaded images, logos, and abstract figures live. Use an absolute
# path in production so it survives code redeploys.
UPLOAD_FOLDER="./uploads"

# =============================================================================
# Server-side cookie hardening
# =============================================================================
# Set to 1 when serving over HTTPS (always true behind Cloudflare).
SESSION_COOKIE_SECURE=1

# =============================================================================
# Cloudflare Tunnel — zero-config deployment
# =============================================================================
# Your domain name.  Required.
# CLOUDFLARE_DOMAIN="your-domain.example.org"

# Optional subdomain (e.g. "www" for www.example.org). Leave blank for apex.
# CLOUDFLARE_SUBDOMAIN=""

# Cloudflare API token.  The launch script uses this to create and manage
# your tunnel via the REST API.  `cloudflared tunnel login` is never needed.
#
# Two token flavours — both need these scopes:
#   Account → Argo Tunnel (Legacy) : Edit
#   Zone    → DNS                 : Edit  (your-domain.example.org only)
#
# Recommended: account-owned (prefix `cfat_`)
#   Dashboard → Manage Account → Account API Tokens → Create Token
#   Bound to a single account; survives the creator leaving.
#   Also set CLOUDFLARE_ACCOUNT_ID below (account-owned tokens cannot
#   enumerate accounts via the API).
#
# Alternative: user-owned (prefix `cfut_` or legacy unprefixed)
#   Dashboard → My Profile → API Tokens → Create Token
#   Same scopes above, plus  User → User Details : Read.
#   No Account ID needed (user token can enumerate accounts).
# CLOUDFLARE_API_TOKEN=""

# Account ID (only needed for account-owned / cfat_ tokens).
# Find it in the right sidebar of any Cloudflare dashboard page:
# Account Home → "Account ID".  32 hex characters.
# CLOUDFLARE_ACCOUNT_ID=""

# =============================================================================
# Payment gateway (managed via Admin → Financial panel, NOT env vars)
# =============================================================================
# ANZ Worldline payment credentials are configured entirely through the
# admin Financial panel (Settings → Financial).  No environment variables
# are needed — the panel stores API keys, webhook secrets, and toggles
# sandbox/live mode.  Invoice email templates are also managed there.
#
# =============================================================================
# Gunicorn tuning (used by launch.sh and systemd units)
# =============================================================================
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=32
# PORT=5005

# =============================================================================
# Health-check monitor (scripts/healthcheck.py)
# =============================================================================
# Override the auto-detected site URL. Needed if the site is behind a proxy
# or you want to check a specific endpoint.
# SITE_URL="https://your-domain.example.org"

# Consecutive failures before sending an alert email.
# HEALTHCHECK_RETRIES=3

# Seconds to wait between retries.
# HEALTHCHECK_RETRY_DELAY=30

# HTTP request timeout in seconds.
# HEALTHCHECK_TIMEOUT=15

# Minutes to suppress repeat alerts after the last one was sent.
# HEALTHCHECK_COOLDOWN=60

# =============================================================================
# Backup (scripts/backup.py)
# =============================================================================
# Number of days to keep daily backups before auto-pruning.
# BACKUP_KEEP_DAYS=30

# =============================================================================
# Update checker (future)
# =============================================================================
# Git remote checked by the admin-only update notifier. Leave blank to disable.
UPDATE_REMOTE_URL=""
UPDATE_BRANCH="main"
