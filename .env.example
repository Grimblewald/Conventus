# =============================================================================
# Secrets & infrastructure config — copy to .env and edit before first launch.
# =============================================================================
# The first-run web wizard will refuse to start unless SECRET_KEY is set to
# something other than the default below. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY="CHANGE-ME-generate-with-secrets.token_urlsafe-48"

# ---------- Runtime mode --------------------------------------------------- #
# production | development. Production enables HTTPS-only cookies, strict CSP,
# and disables the debugger.
FLASK_ENV="production"
FLASK_DEBUG=0

# ---------- Database ------------------------------------------------------- #
# Leave unset for SQLite (default — fine for small deployments). For Postgres:
#   DATABASE_URL="postgresql+psycopg://user:pass@host:5432/society"
# DATABASE_URL=""

# Connection pool tuning — relevant for Postgres under bursty load.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ---------- Rate limiting / cache backend --------------------------------- #
# memory:// (default, single-process), redis://host:6379, etc.
# Use redis when running multiple gunicorn workers / hosts so OTP throttles
# are shared.
RATELIMIT_STORAGE_URI="memory://"

# ---------- Email --------------------------------------------------------- #
# MAIL_BACKEND: console | smtp
# console prints OTPs to stdout — fine for local dev, DO NOT use in production.
MAIL_BACKEND="console"

# SMTP settings (only used when MAIL_BACKEND=smtp)
# Port 465 = implicit TLS, 587 = STARTTLS, 25 = plaintext (avoid).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_TIMEOUT=15
MAIL_FROM="Your Society <noreply@example.com>"

# ---------- Uploads ------------------------------------------------------- #
# Where uploaded images and abstract figures live. Absolute path recommended
# in production so it survives code redeploys.
UPLOAD_FOLDER="./uploads"

# ---------- Server-side cookie hardening ---------------------------------- #
# Set to 1 when serving over HTTPS (always true behind Cloudflare).
SESSION_COOKIE_SECURE=1

# ---------- Update checker (optional, future) ----------------------------- #
# Git remote checked by the admin-only update notifier. Leave blank to disable.
UPDATE_REMOTE_URL=""
UPDATE_BRANCH="main"
