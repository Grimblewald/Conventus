# Cloudflare tunnel config — copy to .cloudflared/config.yml in the project,
# edit `tunnel:` and `hostname:`, then:
#
#   cloudflared tunnel login                # one-time
#   cloudflared tunnel create society-site
#   cloudflared --config deploy/cloudflared/config.yml tunnel run society-site
#
# Paired with `cloudflared tunnel route dns society-site app.example.org`
# so Cloudflare's DNS points the hostname at this tunnel.

tunnel: society-site
credentials-file: ${HOME}/.cloudflared/society-site.json

ingress:
  - hostname: app.example.org
    service: http://127.0.0.1:5005
  - service: http_status:503
