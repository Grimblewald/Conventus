[Unit]
Description=Conventus (Cloudflare Tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=REPLACE_WITH_PROJECT_ROOT
EnvironmentFile=REPLACE_WITH_PROJECT_ROOT/.env
ExecStart=REPLACE_WITH_PROJECT_ROOT/scripts/launch_cloudflared.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
