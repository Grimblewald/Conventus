[Unit]
Description=Society Site (Cloudflare Tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/society-site
EnvironmentFile=/opt/society-site/.env
ExecStart=/opt/society-site/.venv/bin/bash scripts/launch_cloudflared.sh
Restart=always
RestartSec=10

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/society-site/instance /opt/society-site/uploads /opt/society-site/var /opt/society-site/.cloudflared

[Install]
WantedBy=multi-user.target
