[Unit]
Description=Conventus (Cloudflare Tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change these to match where you cloned the repo.  Pick a user that can
# read/write the project directory and has cloudflared on its PATH.
User=REPLACE_WITH_YOUR_USER
Group=REPLACE_WITH_YOUR_USER
WorkingDirectory=REPLACE_WITH_PROJECT_ROOT
EnvironmentFile=REPLACE_WITH_PROJECT_ROOT/.env
# systemd's default PATH is minimal and doesn't include the user's local
# bin (where uv, pipx, cargo install to).  We extend it so the launch
# scripts can find uv.
Environment=PATH=/usr/local/bin:/usr/bin:/bin:REPLACE_WITH_USER_HOME/.local/bin:REPLACE_WITH_USER_HOME/.cargo/bin
# uv writes to ~/.cache/uv by default, but ProtectHome=read-only blocks
# writes to the home directory.  Point it at the project's var/ instead.
Environment=UV_CACHE_DIR=REPLACE_WITH_PROJECT_ROOT/var/uv-cache
Environment=XDG_CACHE_HOME=REPLACE_WITH_PROJECT_ROOT/var
ExecStart=REPLACE_WITH_PROJECT_ROOT/scripts/launch_cloudflared.sh
Restart=always
RestartSec=10

# Hardening — adjust ReadWritePaths to match your project root.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=REPLACE_WITH_PROJECT_ROOT/instance REPLACE_WITH_PROJECT_ROOT/uploads REPLACE_WITH_PROJECT_ROOT/var REPLACE_WITH_PROJECT_ROOT/.cloudflared

[Install]
WantedBy=multi-user.target
