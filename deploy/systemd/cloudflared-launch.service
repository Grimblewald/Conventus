[Unit]
Description=Conventus (Cloudflare Tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/conventus
EnvironmentFile=/opt/conventus/.env
ExecStart=/opt/conventus/.venv/bin/bash scripts/launch_cloudflared.sh
Restart=always
RestartSec=10

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/conventus/instance /opt/conventus/uploads /opt/conventus/var /opt/conventus/.cloudflared

[Install]
WantedBy=multi-user.target
