# systemd unit for a single-VPS deployment.
#
# 1. Copy this file to /etc/systemd/system/society-site.service
# 2. Edit User/WorkingDirectory/EnvironmentFile below.
# 3. systemctl daemon-reload && systemctl enable --now society-site

[Unit]
Description=Society Site (Flask + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/society-site
EnvironmentFile=/opt/society-site/.env
ExecStart=/opt/society-site/.venv/bin/gunicorn \
          --workers 3 --threads 32 --worker-class gthread \
          --bind 127.0.0.1:5005 --timeout 30 \
          --access-logfile /var/log/society-site/access.log \
          --error-logfile  /var/log/society-site/error.log \
          wsgi:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/society-site/instance /opt/society-site/uploads /var/log/society-site

[Install]
WantedBy=multi-user.target
